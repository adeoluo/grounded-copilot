flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge
    Claude([Anthropic Messages API<br/>optional AnthropicProvider]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>evaluate | ask | serve"]:::edge
        Router["service.py router<br/>/health /ready /ask /evaluate /metrics"]:::core
        Validate["Request validation<br/>question, max 2000 characters"]:::control
    end

    subgraph Core["Copilot pipeline (copilot.py)"]
        direction TB
        Retrieve["TF-IDF retriever<br/>top 3 passages and score"]:::core
        Gate{"Abstain gate<br/>top score below 0.08"}:::control
        Prompt["Prompt builder<br/>numbered passages and question"]:::core
        Provider["Provider<br/>offline composer by default"]:::core
        Cite["Citation parser<br/>passage numbers to sources"]:::core
    end

    subgraph State["Data and state (in memory)"]
        direction TB
        KB[("Knowledge base<br/>passages with sources")]:::data
        Cases[("Question cases<br/>answerable and out of scope")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Faith["Faithfulness check<br/>sentences supported by cited passages"]:::obs
        Answer["Answer JSON<br/>citations or abstention"]:::obs
        Bench["evaluation.py<br/>abstention accuracy, faithfulness, coverage"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /ask| Validate
    Validate -->|question| Retrieve
    CLI -->|question| Retrieve
    KB -.->|indexed passages| Retrieve
    Retrieve -->|hits and top score| Gate
    Gate -->|weak: abstain| Answer
    Gate -->|strong| Prompt
    Prompt -->|system and prompt| Provider
    Provider -->|when passed in| Claude
    Provider -->|raw answer| Cite
    Cite -->|cited passages| Faith
    Faith -->|score| Answer
    Cases -.->|expected behavior| Bench
    Answer -->|per-case results| Bench
    Router -.->|route latency and errors| Metrics
