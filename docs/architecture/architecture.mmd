flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>evaluate, ask, serve"]:::edge
        Router["HTTP service<br/>/ask /evaluate /metrics"]:::core
        Validate["Validation<br/>question, max 2000"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        KB[("Knowledge base<br/>passages, sources")]:::data
        Cases[("Question cases<br/>in and out of scope")]:::data
        KB ~~~ Cases
    end

    subgraph Core["Copilot pipeline"]
        direction TB
        Retrieve["TF-IDF retrieval<br/>top 3 and score"]:::core
        Gate{"Abstain gate<br/>score below 0.08"}:::control
        Prompt["Prompt builder<br/>numbered passages"]:::core
        Provider["Provider<br/>offline composer"]:::core
        Claude([Anthropic API<br/>optional provider]):::edge
        Cite["Citation parser<br/>numbers to sources"]:::core
        Retrieve --> Gate -->|strong| Prompt --> Provider --> Cite
        Provider -.-> Claude
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Faith["Faithfulness<br/>cited sentence support"]:::obs
        Answer["Answer JSON<br/>citations or abstention"]:::obs
        Bench["Benchmark<br/>abstention, coverage"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Faith --> Answer --> Bench
        Bench ~~~ Metrics
    end

    Interfaces -->|question| Core
    State -.->|passages| Core
    Core -->|answer or abstention| Obs
    State -.->|expected behavior| Obs
